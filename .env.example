# Database (required for production)
DATABASE_URL=postgresql://user:password@host:5432/sterling_credit

# Server
PORT=5000
NODE_ENV=production

# Clerk Authentication (sign up at https://clerk.com)
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# File Storage - S3/R2 (optional, falls back to local storage)
# S3_BUCKET=sterling-credit-uploads
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=  # For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
